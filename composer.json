{
  "name": "tangible/rule-engine",
  "description": "Extensible rule engine: AND-of-OR condition trees built on tangible/ast, with WP filter-driven operand registration.",
  "type": "jetpack-library",
  "license": "GPL-2.0-only",
  "repositories": [
    {
      "type": "path",
      "url": "../ast",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "Tangible\\RuleEngine\\": "./src"
    }
  },
  "authors": [
    {
      "name": "Team Tangible"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "tangible/ast": "^0.1.2"
  },
  "extra": {
    "branch-alias": {
      "dev-trunk": "0.1.x-dev"
    },
    "textdomain": "tangible-rule-engine"
  }
}
